{
  "name": "peak-mind",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "node --test orchestrator/*.test.js senses/*.test.js",
    "bakeoff:brain": "node bakeoff/brain/run.js",
    "perf": "node scripts/perf.js",
    "start": "node orchestrator/index.js",
    "up": "sh scripts/up.sh",
    "down": "sh scripts/down.sh",
    "status": "sh scripts/status.sh",
    "dev": "node --watch orchestrator/index.js",
    "hearing": "node senses/hearing.js",
    "whisper": "whisper-server -m ${PEAK_WHISPER_GGML:-$HOME/.cache/whisper.cpp/ggml-medium.en.bin} --host 127.0.0.1 --port 8178 -l en --no-timestamps",
    "vision": "node senses/vision.js",
    "presence": "node senses/presence.js",
    "voice": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; if [ \"${PEAK_VOICE_BACKEND:-homepod}\" = kokoro ]; then exec voice/.venv-kokoro/bin/python -u voice/local.py; else exec voice/.venv/bin/python -u voice/homepod.py; fi'",
    "record": "node scripts/record.js",
    "trick": "node scripts/trick.js",
    "device": "node scripts/device.js",
    "teach": "node scripts/teach.js",
    "pub": "node scripts/pub.js",
    "sub": "node scripts/sub.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mqtt": "^5.10.0",
    "yaml": "^2.9.1"
  }
}
