PEAK_BROKER=mqtt://localhost:1883
PEAK_MODEL=huihui_ai/qwen3-vl-abliterated:8b-instruct
PEAK_VISION_MODEL=qwen3-vl:4b-instruct
PEAK_MIN_DB=-30
PEAK_WHISPER_URL=http://127.0.0.1:8178
PEAK_NUM_CTX=4096
PEAK_TEMPERATURE=0.3
PEAK_KEEP_ALIVE=30m
# npm run voice: AirPlay speaker for the spoken lines (name as in the Home app; host is optional)
PEAK_SPEAKER=
PEAK_SPEAKER_HOST=
PEAK_VOICE=Daniel
# 1 lets the brain pick a trick for the eyes with each reply ({gesture, eyes, say}); off by default, see CLAUDE.md
PEAK_BRAIN_EYES=0
# 1 lets the brain switch a device from devices/devices.yaml with each reply ({gesture, eyes, action, say}); off by default
PEAK_BRAIN_DEVICES=0
# examples the brain's prompt shows (examples/examples.yaml plus examples/learned.yaml from npm run teach): 0 = all of
# them, N = the N nearest to the event, picked by embedding (embed, qwen3-embedding:0.6b through Ollama) or by word
# overlap (lexical); a failed or slow embedding call falls back to words
PEAK_EXAMPLES_K=0
PEAK_EXAMPLES_PICK=embed
PEAK_EMBED_MODEL=qwen3-embedding:0.6b
PEAK_EMBED_TIMEOUT_MS=400
