# sudo cp peak-servod.service /etc/systemd/system/ && sudo systemctl enable --now peak-servod
[Unit]
Description=peak servo node
After=network-online.target

[Service]
# The Mac by mDNS name; a fixed IP breaks when the router hands out a new lease
Environment=PEAK_BROKER=twentyones-Mac-mini.local
Environment=PEAK_NODE=mech
WorkingDirectory=/home/lupin/peak/node
ExecStart=/home/lupin/peak/.venv/bin/python servod.py
Restart=always
RestartSec=3
User=lupin

[Install]
WantedBy=multi-user.target
